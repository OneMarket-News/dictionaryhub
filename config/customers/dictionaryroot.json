{
  "schemaVersion": "1.1",
  "customerId": "dictionaryroot",
  "customerName": "DictionaryRoot",
  "applicationType": "dictionary-knowledge-platform",
  "domain": "DictionaryRoot",
  "environment": "development",
  "status": "active",
  "apiBaseUrl": "http://localhost:3000/api/v1",
  "bundleId": "dictionaryroot-oewn-2025-pilot-500",
  "dataset": {
    "name": "Open English WordNet",
    "release": "2025",
    "license": "CC BY 4.0"
  },
  "defaults": {
    "searchTerm": "knowledge",
    "pageSize": 25
  },
  "graph": {
    "initialDepth": 1,
    "initialNodeLimit": 28,
    "maximumNodeLimit": 150,
    "neighborsPerExpansion": 18
  },
  "features": {
    "search": true,
    "conceptExplorer": true,
    "knowledgeGraph": true,
    "sources": true,
    "advancedDetails": true,
    "editorialReview": true,
    "identityAccess": true
  },
  "dynamicExpansion": {
    "defaultDepth": 1,
    "maximumDepth": 2,
    "maximumVisibleNodes": 72,
    "maximumBranches": 8
  },
  "editorial": {
    "defaultCategory": "needs-review",
    "defaultStatus": "all",
    "pageSize": 20,
    "reviewerLabel": "Local reviewer"
  },
  "identity": {
    "mode": "development",
    "providerInterfaceVersion": "1.0",
    "sessionStorageKey": "dictionaryroot.auth.session",
    "developmentSessionHours": 12,
    "actorTypes": [
      "human",
      "organization",
      "service",
      "autonomous_agent"
    ],
    "verifiedHumanRequiredFor": [
      "editorial.approve",
      "graph.promote"
    ],
    "autonomousAgentFinalization": false
  }
}
