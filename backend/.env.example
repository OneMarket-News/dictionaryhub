PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5500
# Optional during the first milestone. When set, /health checks PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sourceroot
# DictionaryRoot identity foundation. Development mode enables local fixture identities only.
SOURCEROOT_AUTH_MODE=development
SOURCEROOT_AUTH_SESSION_HOURS=12
