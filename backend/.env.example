# SourceRoot / DictionaryRoot local development
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sourceroot
SOURCEROOT_JSON_LIMIT=100mb
REQUEST_LOGGING=false

# Public URLs and browser access
FRONTEND_PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# In development only, also allow loopback browser origins such as VS Code Live Server on port 5500.
ALLOW_LOCAL_DEVELOPMENT_ORIGINS=true
TRUST_PROXY=false

# Sessions
SESSION_DURATION_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Local-only authentication adapter. Keep false outside local development.
ALLOW_DEVELOPMENT_AUTH=true
EXPOSE_DEVELOPMENT_AUTH_LINK=true
BOOTSTRAP_ADMIN_EMAILS=admin@dictionaryroot.local

# Email magic links and invitations: console or resend
EMAIL_DELIVERY_MODE=console
EMAIL_LINK_TTL_MINUTES=15
EMAIL_FROM=DictionaryRoot <accounts@example.com>
RESEND_API_KEY=

# Google OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple web Services ID
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Put the PEM value on one line with escaped newlines, or inject it through your host's secret manager.
APPLE_PRIVATE_KEY=

# Governed editorial policy
ALLOW_SELF_APPROVAL=false

# Source imports. For legacy local scripts only, development can temporarily allow unauthenticated import.
ALLOW_UNAUTHENTICATED_IMPORT=true
IMPORT_SERVICE_TOKEN=replace-with-a-long-random-production-token
