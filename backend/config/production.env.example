PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
FRONTEND_PUBLIC_URL=https://dictionaryroot.example
BACKEND_PUBLIC_URL=https://api.dictionaryroot.example
CORS_ORIGIN=https://dictionaryroot.example
TRUST_PROXY=true
SESSION_DURATION_DAYS=14
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
ALLOW_DEVELOPMENT_AUTH=false
EXPOSE_DEVELOPMENT_AUTH_LINK=false
BOOTSTRAP_ADMIN_EMAILS=owner@example.com
EMAIL_DELIVERY_MODE=resend
EMAIL_FROM=DictionaryRoot <accounts@dictionaryroot.example>
RESEND_API_KEY=SECRET_MANAGER_VALUE
GOOGLE_CLIENT_ID=SECRET_MANAGER_VALUE
GOOGLE_CLIENT_SECRET=SECRET_MANAGER_VALUE
APPLE_CLIENT_ID=SECRET_MANAGER_VALUE
APPLE_TEAM_ID=SECRET_MANAGER_VALUE
APPLE_KEY_ID=SECRET_MANAGER_VALUE
APPLE_PRIVATE_KEY=SECRET_MANAGER_VALUE
ALLOW_SELF_APPROVAL=false
ALLOW_UNAUTHENTICATED_IMPORT=false
IMPORT_SERVICE_TOKEN=SECRET_MANAGER_VALUE
