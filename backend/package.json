{
  "name": "sourceroot-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SourceRoot backend with DictionaryRoot authentication, governed editorial workflow, moderation, audit, and provenance APIs.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:compiled": "node dist/server.js",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:context": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/contextual-knowledge.test.ts",
    "test:historyroot:plymouth": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/historyroot-plymouth.test.ts",
    "test:governance:historyroot": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/governed-historyroot.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:test": "node --env-file=.env.test --import tsx src/scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dictionaryroot:pilot": "tsx src/scripts/build-dictionaryroot-pilot.ts",
    "dictionaryroot:lexicon": "tsx src/scripts/import-dictionaryroot-lexicon.ts",
    "historyroot:plymouth:generate": "tsx src/scripts/generate-historyroot-plymouth.ts",
    "historyroot:plymouth:validate": "tsx src/scripts/validate-historyroot-plymouth.ts",
    "historyroot:plymouth:import": "tsx src/scripts/import-historyroot-plymouth.ts",
    "historyroot:plymouth:verify": "npm run test:historyroot:plymouth",
    "historyroot:plymouth:remove": "tsx src/scripts/remove-historyroot-plymouth.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
