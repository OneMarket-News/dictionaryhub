{
  "name": "sourceroot-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SourceRoot backend with DictionaryRoot authentication, governed editorial workflow, moderation, audit, and provenance APIs.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:compiled": "node dist/server.js",
    "test": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/**/*.test.ts",
    "test:context": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/contextual-knowledge.test.ts",
    "test:context-refinement": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/contextual-identity-time.test.ts",
    "test:context-assertions-versioning": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/contextual-assertions-evidence-versioning.test.ts",
    "test:context-review": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/context-api-review-experience.test.ts",
    "test:context-review-frontend": "node --test ../verification/context-review-experience.test.cjs",
    "test:registry-contract": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/registry-api-contract.test.ts",
    "test:observability": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/observability.test.ts test/observers.test.ts",
    "test:frontend-observability": "node --test ../verification/frontend-api-observability.test.cjs",
    "test:historyroot:plymouth": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/historyroot-plymouth.test.ts",
    "test:governance:historyroot": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/governed-historyroot.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:test": "node --env-file=.env.test --import ./scripts/register-tsx.mjs src/scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dictionaryroot:pilot": "tsx src/scripts/build-dictionaryroot-pilot.ts",
    "dictionaryroot:lexicon": "tsx src/scripts/import-dictionaryroot-lexicon.ts",
    "historyroot:plymouth:generate": "tsx src/scripts/generate-historyroot-plymouth.ts",
    "historyroot:plymouth:validate": "tsx src/scripts/validate-historyroot-plymouth.ts",
    "historyroot:plymouth:import": "tsx src/scripts/import-historyroot-plymouth.ts",
    "historyroot:plymouth:verify": "npm run test:historyroot:plymouth",
    "historyroot:plymouth:remove": "tsx src/scripts/remove-historyroot-plymouth.ts",
    "historyroot:foundational:generate": "tsx src/scripts/generate-historyroot-foundational-corpus.ts",
    "historyroot:foundational:import": "node --env-file=.env.test --import ./scripts/register-tsx.mjs src/scripts/import-historyroot-foundational-corpus.ts",
    "test:historyroot:foundational": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/historyroot-foundational-corpus.test.ts",
    "prepare:source-workspace": "node --import ./scripts/register-tsx.mjs src/scripts/prepare-sourceroot-workspace.ts",
    "test:source-preparation": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/source-preparation-workflow.test.ts",
    "test:source-preparation:lossless": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/source-preparation-lossless-context.test.ts",
    "historyroot:expansion:initialize": "node --import ./scripts/register-tsx.mjs src/scripts/generate-historyroot-corpus-expansion.ts --initialize-workspace",
    "historyroot:expansion:generate": "node --import ./scripts/register-tsx.mjs src/scripts/generate-historyroot-corpus-expansion.ts",
    "historyroot:expansion:import": "node --env-file=.env.test --import ./scripts/register-tsx.mjs src/scripts/import-historyroot-corpus-expansion.ts",
    "test:historyroot:expansion": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/historyroot-corpus-expansion-quality.test.ts",
    "historyroot:wampanoag-regional:generate": "node --import ./scripts/register-tsx.mjs src/scripts/generate-historyroot-wampanoag-regional-corpus.ts",
    "historyroot:wampanoag-regional:import": "node --env-file=.env.test --import ./scripts/register-tsx.mjs src/scripts/import-historyroot-wampanoag-regional-corpus.ts",
    "test:historyroot:wampanoag-regional": "node --env-file=.env.test --import ./scripts/register-tsx.mjs --test --test-concurrency=1 test/historyroot-wampanoag-regional-corpus.test.ts",
    "verify:fresh-install": "node scripts/verify-fresh-install.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
